APP_PORT=8000
REDIS_HOST=redis
REDIS_PORT=6379

POSTGRES_USER=url_shortener
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=url_shortener

# Host-run development configuration; export DATABASE_URL before running Go.
# The application does not automatically load .env. Compose uses postgresql:5432.
DATABASE_URL='postgres://url_shortener:local_dev_password@localhost:5432/url_shortener?sslmode=disable'

# Developers must run migrations locally before starting the API; see README.md.
# Keep this tracking table unchanged for databases with existing migration history.
GOOSE_MIGRATION_DIR=./database/postgres/migrations
GOOSE_DRIVER=postgres
GOOSE_TABLE=custom.goose_migrations
GOOSE_DBSTRING='postgres://url_shortener:local_dev_password@localhost:5432/url_shortener?sslmode=disable'